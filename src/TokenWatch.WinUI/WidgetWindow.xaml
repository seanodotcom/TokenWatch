<Window x:Class="TokenWatch.WinUI.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TokenWatch · WinUI preview">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="#202329" Padding="12,10,12,10" RowSpacing="4">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <Button x:Name="CountdownButton" Style="{StaticResource QuietButton}" Padding="0" Click="Countdown_Click" AutomationProperties.Name="Refresh countdown and interval">
        <Button.Flyout><MenuFlyout x:Name="IntervalFlyout"/></Button.Flyout>
        <Grid Width="28" Height="28"><Ellipse Width="22" Height="22" Stroke="#3C414B" StrokeThickness="3"/><Path x:Name="CountdownArc" Stroke="#5685FF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Ellipse Width="4" Height="4" Fill="#5685FF"/></Grid>
      </Button>
      <Grid Grid.Column="1" x:Name="DragRegion" Background="Transparent" VerticalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Grid><TextBlock x:Name="FullTitle" Text="TokenWatch" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ShortTitle" Text="TW" FontSize="17" FontWeight="SemiBold" Visibility="Collapsed"/></Grid><TextBlock x:Name="VersionText" Text="v0.5.9" FontSize="10" Foreground="{StaticResource QuietText}" VerticalAlignment="Center"/></StackPanel>
      </Grid>
      <ToggleButton x:Name="PinButton" Grid.Column="2" Click="Pin_Click" MinWidth="28" MinHeight="30" Width="30" Padding="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Always on top" AutomationProperties.Name="Always on top"><FontIcon Glyph="&#xE718;" FontSize="14"/></ToggleButton>
      <Button Grid.Column="3" Style="{StaticResource QuietButton}" Click="Settings_Click" ToolTipService.ToolTip="Manage providers" AutomationProperties.Name="Manage providers"><FontIcon Glyph="&#xE713;" FontSize="15"/></Button>
      <Button Grid.Column="4" Style="{StaticResource QuietButton}" Click="Close_Click" ToolTipService.ToolTip="Hide to tray" AutomationProperties.Name="Hide widget"><FontIcon Glyph="&#xE8BB;" FontSize="13"/></Button>
    </Grid>
    <StackPanel x:Name="ProviderStack" Grid.Row="1" VerticalAlignment="Top"/>
    <Grid Grid.Row="2" Margin="0,6,0,0"><TextBlock x:Name="BuildCaption" Text="TOKENWATCH" FontSize="9" CharacterSpacing="110" Foreground="#8F96A5" VerticalAlignment="Center"/><TextBlock x:Name="ModeCaption" Text="Sample data · remaining" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource QuietText}" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
