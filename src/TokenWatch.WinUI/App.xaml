<Application x:Class="TokenWatch.WinUI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="QuietText" Color="#A5AAB7"/>
      <SolidColorBrush x:Key="Surface" Color="#202329"/>
      <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinWidth" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="7"/><Setter Property="CornerRadius" Value="6"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
