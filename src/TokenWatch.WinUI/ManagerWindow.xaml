<Window x:Class="TokenWatch.WinUI.ManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TokenWatch.WinUI" Title="TokenWatch · Settings preview">
  <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="164" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" IsPaneOpen="True" SelectionChanged="Navigation_SelectionChanged" AlwaysShowHeader="False" CompactPaneLength="48" IsTitleBarAutoPaddingEnabled="False">
      <NavigationView.PaneHeader><StackPanel Orientation="Horizontal" Spacing="9" Margin="18,22,0,24"><Image Source="Assets/tokenwatch.png" Width="24" Height="24"/><TextBlock Text="TokenWatch" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></StackPanel></NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="ProvidersNav" Content="Providers" Tag="providers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Appearance" Tag="appearance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE790;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="StateNav" Content="Activity" Tag="states"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter><StackPanel Margin="20,0,12,22" Spacing="5"><TextBlock x:Name="AppVersionCaption" Text="v0.5.9" FontSize="11" Foreground="{StaticResource QuietText}"/><TextBlock Text="Native WinUI 3" FontSize="10" Foreground="{StaticResource QuietText}"/></StackPanel></NavigationView.PaneFooter>
      <Grid Padding="30,24,30,18" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="Providers" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Choose what appears in your widget." FontSize="13" Foreground="{StaticResource QuietText}"/></StackPanel><Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Padding="14,8"><Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="12"/><TextBlock Text="Add provider"/></StackPanel></Button.Content><Button.Flyout><MenuFlyout x:Name="AddFlyout" Opening="AddFlyout_Opening"/></Button.Flyout></Button></Grid>
        <Grid x:Name="ProvidersPage" Grid.Row="1" ColumnSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="YOUR PROVIDERS" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource QuietText}"/>
            <Grid Grid.Row="1"><ListView x:Name="ProviderList" SelectionMode="Single" CanDragItems="True" AllowDrop="True" CanReorderItems="True" SelectionChanged="Provider_SelectionChanged" AutomationProperties.Name="Your providers, drag to reorder" Background="Transparent">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="CornerRadius" Value="7"/></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <Image Source="{Binding LogoImage}" Width="26" Height="26" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource QuietText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <ToggleSwitch Grid.Column="2" IsOn="{Binding Enabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
              </Grid></DataTemplate></ListView.ItemTemplate>
            </ListView><TextBlock x:Name="EmptyListText" Text="Your widget starts here.&#xA;Add a provider above." FontSize="14" Foreground="{StaticResource QuietText}" TextWrapping="Wrap" Margin="12,20" Visibility="Collapsed"/></Grid>
            <StackPanel Grid.Row="2" Spacing="10"><TextBlock Text="Drag to reorder, or use the arrow buttons." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource QuietText}"/><StackPanel Orientation="Horizontal" Spacing="5"><Button x:Name="MoveUpButton" Click="MoveUp_Click" ToolTipService.ToolTip="Move selected provider up" AutomationProperties.Name="Move selected provider up"><FontIcon Glyph="&#xE70E;" FontSize="13"/></Button><Button x:Name="MoveDownButton" Click="MoveDown_Click" ToolTipService.ToolTip="Move selected provider down" AutomationProperties.Name="Move selected provider down"><FontIcon Glyph="&#xE70D;" FontSize="13"/></Button><Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click"/></StackPanel></StackPanel>
          </Grid>
          <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="22">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Spacing="18">
              <StackPanel Spacing="6"><TextBlock Text="CONNECTION DETAILS" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource QuietText}"/><TextBlock x:Name="SelectedName" Text="GitHub Copilot" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectedSubtitle" Text="AI credits and monthly allowances" FontSize="12" Foreground="{StaticResource QuietText}" TextWrapping="Wrap"/></StackPanel>
              <InfoBar x:Name="ConnectionInfo" IsOpen="True" IsClosable="False" Severity="Success" Title="Sample connection ready" Message="Usage values in this preview are simulated."/>
              <StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sign-in source" Foreground="{StaticResource QuietText}" FontSize="12"/><TextBlock Grid.Column="1" x:Name="SignInSource" Text="GitHub CLI" FontSize="12"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Last successful check" Foreground="{StaticResource QuietText}" FontSize="12"/><TextBlock Grid.Column="1" x:Name="LastCheck" Text="Not checked" FontSize="12"/></Grid></StackPanel>
              <TextBlock x:Name="ConnectionGuidance" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="#C8CCD5"/>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConnectionButton" Content="Check connection" Style="{StaticResource AccentButtonStyle}" Click="Connection_Click"/><Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click" Visibility="Collapsed"/><Button x:Name="UsageButton" Content="Usage page" Click="Usage_Click"/></StackPanel>
              <StackPanel x:Name="CodexOptions" Visibility="Collapsed" Spacing="8"><TextBlock Text="Codex executable (optional)" FontSize="12"/><TextBox x:Name="CodexPath" PlaceholderText="Automatic detection" AutomationProperties.Name="Codex executable path"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Browse" Click="BrowseCodex_Click"/><Button Content="Apply path" Click="SaveCodex_Click"/></StackPanel></StackPanel><Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
              <StackPanel Spacing="7"><TextBlock Text="QUOTAS IN YOUR WIDGET" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource QuietText}"/><StackPanel x:Name="QuotaSummary" Spacing="9"/></StackPanel>
              <TextBlock Text="Removing a provider hides it from TokenWatch. Its existing app sign-in is retained." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource QuietText}"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <ScrollViewer x:Name="AppearancePage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="Keep the widget comfortable to read at a glance." TextWrapping="Wrap" Foreground="{StaticResource QuietText}"/>
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="20"><ToggleSwitch x:Name="RemainingSwitch" Header="Show remaining quota" OnContent="Remaining" OffContent="Used" Toggled="Preference_Toggled"/><ToggleSwitch x:Name="ResetSwitch" Header="Show quota reset times and dates" OnContent="Time today · date for later resets" OffContent="Hidden" Toggled="Preference_Toggled"/><ToggleSwitch x:Name="KeepOpenSwitch" Header="Keep widget open when I click elsewhere" OnContent="Keep open" OffContent="Hide on focus loss" Toggled="Preference_Toggled"/><ToggleSwitch x:Name="TopmostSwitch" Header="Keep widget above other windows" OnContent="Always on top" OffContent="Normal stacking" Toggled="Preference_Toggled"/></StackPanel></Border>
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="12"><ToggleSwitch x:Name="PaceMarkersSwitch" Header="Show expected usage markers" OnContent="Shown on weekly quotas" OffContent="Hidden" Toggled="Preference_Toggled"/><NumberBox x:Name="DailyUsagePicker" Header="Daily usage budget (%)" Minimum="1" Maximum="100" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact" Width="200" HorizontalAlignment="Left" ValueChanged="DailyUsage_ValueChanged" AutomationProperties.Name="Daily usage budget percent"/><TextBlock Text="Expected usage by each weekday's close. Weekends are excluded; partial reset days are prorated. Defaults to 20% per day." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource QuietText}"/></StackPanel></Border>
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="9"><TextBlock Text="Refresh interval" FontWeight="SemiBold"/><ComboBox x:Name="RefreshPicker" Width="180" SelectionChanged="Refresh_SelectionChanged" AutomationProperties.Name="Refresh interval"/><TextBlock Text="Automatic usage checks continue while the widget is hidden." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource QuietText}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <StackPanel x:Name="StatesPage" Grid.Row="1" Visibility="Collapsed" Spacing="20" MaxWidth="600" HorizontalAlignment="Left">
          <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Explore connection states" Message="These examples only change sample data. No sign-in or network request is made."/>
          <StackPanel Spacing="10"><TextBlock Text="Provider"/><ComboBox x:Name="StateProviderPicker" Width="260" DisplayMemberPath="Name" AutomationProperties.Name="Preview provider"/><TextBlock Text="Example state"/><ComboBox x:Name="StatePicker" Width="260" SelectedIndex="0" AutomationProperties.Name="Example connection state"><x:String>Connected</x:String><x:String>Stale reading</x:String><x:String>Sign-in required</x:String><x:String>Server cooldown</x:String></ComboBox><Button Content="Apply example" Click="ApplyState_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0"/></StackPanel>
          <TextBlock Text="Sample mode uses simulated readings and does not contact accounts." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource QuietText}"/>
        </StackPanel>
        <StackPanel x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed" Spacing="20"><TextBlock x:Name="ActivityText" FontSize="14" TextWrapping="Wrap"/><Button Content="Refresh usage" Click="RefreshAll_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel><Grid Grid.Row="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveStatus" Text="Changes save automatically · preview preferences only" FontSize="10" Foreground="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="Wrap"/><Border x:Name="SessionBadge" Grid.Column="1" Background="#30415B" CornerRadius="4" Padding="8,4"><TextBlock Text="SAMPLE DATA" FontSize="9" CharacterSpacing="100" Foreground="#ADCAFF"/></Border></Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
